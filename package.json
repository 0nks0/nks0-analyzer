{
  "name": "nks0-analyzer",
  "version": "1.7.0",
  "private": true,
  "description": "NKS0 PCAP Analyzer — static GitHub Pages frontend. No build step: the site is served exactly as committed.",
  "scripts": {
    "test": "node tests/run.js",
    "check-version": "python scripts/bump_version.py --check",
    "bump": "python scripts/bump_version.py",
    "verify": "npm run check-version && npm test",
    "serve": "python -m http.server 7601"
  },
  "devDependencies": {
    "jsdom": "^25.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
